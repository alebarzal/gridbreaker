{
  "name": "gridbreaker",
  "version": "1.2.0",
  "description": "Grid Breaker - arcade breakout de cuadrícula con mundos y jefes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icon.mjs && npx @capacitor/assets generate --android",
    "android": "npm run build && npx cap sync android && npx cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1"
  }
}
